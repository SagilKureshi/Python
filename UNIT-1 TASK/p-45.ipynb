   "source": [
    "import socket\n",
    "\n",
    "# Create a socket\n",
    "s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
    "\n",
    "print(\"Socket created successfully.\")\n",
    "\n",
    "# Close the socket\n",
    "s.close()\n",
    "\n",
    "print(\"Socket closed.\")"
   ]
  }
