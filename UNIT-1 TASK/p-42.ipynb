   "source": [
    "import pylab as plt\n",
    "import numpy as np\n",
    "\n",
    "# Generate values\n",
    "x = np.linspace(-10, 10, 100)\n",
    "\n",
    "# Calculate y values\n",
    "y = x ** 2\n",
    "\n",
    "# Plot the curve\n",
    "plt.plot(x, y)\n",
    "\n",
    "# Add title and labels\n",
    "plt.title(\"Curve: y = x²\")\n",
    "plt.xlabel(\"X-axis\")\n",
    "plt.ylabel(\"Y-axis\")\n",
    "\n",
    "# Display graph\n",
    "plt.grid()\n",
    "plt.show()"
   ]
  }
 ],
