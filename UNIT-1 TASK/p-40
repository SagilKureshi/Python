class Employee:
    def __init__(self, name, salary):
        self.name = name
        self.__salary = salary

    def get_salary(self):
        return self.__salary

    def set_salary(self, new_salary):
        if new_salary > 0:
            self.__salary = new_salary

emp = Employee("Alice", 50000)
print("Name:", emp.name)

emp.set_salary(55000)
print("Salary:", emp.get_salary())
