   "source": [
    "import requests\n",
    "\n",
    "# Image URL\n",
    "url = \"https://www.example.com/image.jpg\"\n",
    "\n",
    "# Download the image\n",
    "response = requests.get(url)\n",
    "\n",
    "# Save the image\n",
    "with open(\"downloaded_image.jpg\", \"wb\") as file:\n",
    "    file.write(response.content)\n",
    "\n",
    "print(\"Image downloaded successfully.\")"
   ]
  }
 ],
