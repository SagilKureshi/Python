   "source": [
    "import socket\n",
    "\n",
    "# Get the computer's hostname\n",
    "hostname = socket.gethostname()\n",
    "\n",
    "# Get the IP address\n",
    "ip_address = socket.gethostbyname(hostname)\n",
    "\n",
    "print(\"Hostname:\", hostname)\n",
    "print(\"IP Address:\", ip_address)"
   ]
  }
