   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "s = [25,25,25,25]\n",
    "label = [\"Apple\",\"Banana\",\"Grapes\",\"Orange\"]\n",
    "myexplode = [0.1,0.1,0.1,0.1]\n",
    "color = [\"red\",\"Yellow\",\"green\",\"Orange\"]\n",
    "plt.pie(s,labels=label,explode=myexplode,colors=color,shadow=True)\n",
    "plt.legend(label)\n",
    "plt.show()"
   ]
